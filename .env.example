# ─────────────────────────────────────────────
#  ALMEER – M-Pesa STK Push Configuration
# ─────────────────────────────────────────────
#  Copy this file to .env and fill in your values
#  Get credentials at: https://developer.safaricom.co.ke

# ENVIRONMENT: sandbox | production
MPESA_ENV=sandbox

# YOUR DARAJA APP CREDENTIALS
MPESA_CONSUMER_KEY=your_consumer_key_here
MPESA_CONSUMER_SECRET=your_consumer_secret_here

# YOUR BUSINESS SHORTCODE (Paybill / Till Number)
# For sandbox testing use: 174379
MPESA_SHORTCODE=174379

# LIPA NA MPESA PASSKEY
# For sandbox: bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919

# YOUR RECEIVING NUMBER / TILL
# This is the number that receives the money
MPESA_RECEIVER=254720313769

# CALLBACK URL – must be a public HTTPS URL
# Use ngrok for local testing: npx ngrok http 3000
MPESA_CALLBACK_URL=https://yourdomain.com/api/mpesa/callback

# SERVER PORT
PORT=3000
